{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug chess",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/chess", // Ensure this points to the correct executable
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "make", // This will run `make` before launching the debugger
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb" // Ensure this path is correct for your system
        }
    ]
}